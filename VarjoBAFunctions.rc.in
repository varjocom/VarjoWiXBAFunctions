#include <winres.h>

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @_version_numbers@
    PRODUCTVERSION @_version_numbers@
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0x0L
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_DLL
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Varjo Technologies Oy"
            VALUE "FileDescription", "User interface functions of the Varjo setup"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "VarjoBAFunctions"
            VALUE "LegalCopyright", "Copyright (c) Varjo Technologies Oy."
            VALUE "OriginalFilename", "VarjoBAFunctions.dll"
            VALUE "ProductName", "VarjoBAFunctions"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
